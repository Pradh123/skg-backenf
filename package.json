{
  "name": "skg-admin-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Secure REST API for SKG Admin and the public SKG website",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-concurrency=1",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongoose": "^8.19.1"
  }
}
